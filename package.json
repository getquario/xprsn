{
	"name": "xprsn",
	"version": "0.8.0",
	"description": "Tiny, CSP-safe expression language for JavaScript. No eval, no new Function.",
	"repository": "getquario/xprsn",
	"license": "Apache-2.0",
	"author": {
		"name": "Robin van der Vleuten",
		"email": "robin@webstronauts.com",
		"url": "https://robinvdvleuten.nl"
	},
	"type": "module",
	"module": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"lib"
	],
	"size-limit": [
		{
			"path": "lib/index.js",
			"limit": "1.85 kB"
		}
	],
	"scripts": {
		"bench": "node --disallow-code-generation-from-strings bench/index.js",
		"check": "run-s size test test:browser fuzz:regression",
		"fuzz": "npm run fuzz:prepare && run-s fuzz:compile fuzz:evaluate fuzz:structured",
		"fuzz:prepare": "node -e \"for (const x of ['compile','evaluate','structured']) require('fs').mkdirSync('.fuzz-corpus/'+x,{recursive:true})\"",
		"fuzz:compile": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/compile.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal|ssrf' --sync .fuzz-corpus/compile fuzz/corpus/compile -- -max_total_time=60 -use_value_profile=1 -dict=fuzz/xprsn.dict -artifact_prefix=fuzz/",
		"fuzz:evaluate": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/evaluate.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal|ssrf' --sync .fuzz-corpus/evaluate fuzz/corpus/evaluate -- -max_total_time=60 -use_value_profile=1 -dict=fuzz/xprsn.dict -artifact_prefix=fuzz/",
		"fuzz:structured": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/structured.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal|ssrf' --sync .fuzz-corpus/structured fuzz/corpus/structured -- -max_total_time=60 -use_value_profile=1 -dict=fuzz/xprsn.dict -artifact_prefix=fuzz/",
		"fuzz:regression": "run-s fuzz:regression:compile fuzz:regression:evaluate fuzz:regression:structured",
		"fuzz:regression:compile": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/compile.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal|ssrf' --sync --mode=regression fuzz/corpus/compile -- -artifact_prefix=fuzz/",
		"fuzz:regression:evaluate": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/evaluate.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal|ssrf' --sync --mode=regression fuzz/corpus/evaluate -- -artifact_prefix=fuzz/",
		"fuzz:regression:structured": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/structured.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal|ssrf' --sync --mode=regression fuzz/corpus/structured -- -artifact_prefix=fuzz/",
		"size": "size-limit",
		"test": "run-s test:unit test:types",
		"test:unit": "node --disallow-code-generation-from-strings --test --test-concurrency=1 test/*.test.js",
		"test:browser": "playwright install chromium && node test/browser/harness.js",
		"test:types": "tsc && attw --pack . --profile esm-only"
	},
	"keywords": [
		"expression",
		"expression-language",
		"csp",
		"parser",
		"evaluate"
	],
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.3",
		"@jazzer.js/bug-detectors": "^4.0.0",
		"@jazzer.js/core": "^4.0.0",
		"@size-limit/preset-small-lib": "^12.1.0",
		"npm-run-all": "^4.1.5",
		"playwright": "^1.61.1",
		"size-limit": "^13.0.3",
		"typescript": "7.0.2"
	}
}
